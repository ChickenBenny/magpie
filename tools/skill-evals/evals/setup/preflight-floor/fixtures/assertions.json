{
  "mention_restart": {
    "type": "regex",
    "field": "reason",
    "pattern": "restart|new session|reload|session start",
    "flags": "is"
  },
  "mention_unknown": {
    "type": "regex",
    "field": "reason",
    "pattern": "unknown",
    "flags": "is"
  },
  "mention_adopt": {
    "type": "regex",
    "field": "reason",
    "pattern": "adopt",
    "flags": "is"
  },
  "has_codex_setup_command": {
    "type": "regex",
    "field": "commands_shown",
    "pattern": "\\$magpie-setup:setup reconcile"
  },
  "has_no_marketplace_setup_command": {
    "type": "regex",
    "field": "commands_shown",
    "pattern": "/magpie-setup:setup",
    "negate": true
  },
  "has_marketplace_setup_command": {
    "type": "regex",
    "field": "commands_shown",
    "pattern": "/magpie-setup:setup reconcile"
  }
}
